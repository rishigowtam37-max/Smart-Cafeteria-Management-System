# FlowBite environment variables (TEMPLATE - this file is tracked by git).
# Copy it to `.env` and put your real key there. NEVER paste a real key here.
#
# These are read by the Spring Boot backend, not by Vite. The key is used
# server-side only, in com.flowbite.service.CravingService, so it is never
# compiled into the browser bundle and cannot be read from the deployed page.
#
# GEMINI_API_KEY powers the "Smart Craving" menu-suggestion feature.
# Get a key from https://aistudio.google.com/apikey
#
# Without a key the app still runs - /api/config reports the feature as off and
# the React app hides the Smart Craving panel.
GEMINI_API_KEY=

# Optional. Overrides the model pinned in application.properties.
# Leave blank unless the default starts returning 404 "no longer available".
GEMINI_MODEL=
