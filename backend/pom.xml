<?xml version="1.0" encoding="UTF-8"?>
<!--
  FlowBite backend - the Spring Boot application that owns every business rule.

  The React app at the repository root is a view layer that calls this service
  over /api. Nothing in the browser decides stock, prices, totals or order IDs.

  Two entry points share one domain:
    com.flowbite.FlowBiteApplication   - the web application (default)
    com.flowbite.console.ConsoleApp    - the original console app, still runnable
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.flowbite</groupId>
  <artifactId>flowbite</artifactId>
  <version>1.0.0</version>
  <name>FlowBite</name>
  <description>Smart Cafeteria Management System - Spring Boot backend</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      Orders are the only state that outlives a restart, so this is plain JDBC
      rather than JPA: two tables, two statements, no mapping layer.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!-- File-based, embedded in the JVM - no database to install or run. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        Every test runs under the "test" profile, which swaps the file-based H2
        order database for an in-memory one (application-test.properties). Set
        here rather than with @ActiveProfiles so that a new @SpringBootTest
        cannot be written that quietly writes into real order data.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <spring.profiles.active>test</spring.profiles.active>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <!--
        Lets the original console app be launched from the same build:
          ./mvnw compile exec:java -Dexec.mainClass=com.flowbite.console.ConsoleApp
        Console I/O needs the real terminal, hence the inherited IO.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.0</version>
      </plugin>
    </plugins>
  </build>

</project>
